/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp LBKT &kp RBKT
                &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp QUOT &kp ENTER
                &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp SLASH &kp UP &kp BSPC
                &kp LCTRL &kp LALT &kp LGUI &kp SPACE &kp SPACE &kp SPACE &kp LEFT &kp DOWN &kp RIGHT &kp TAB &kp ESC &kp RCTRL
            >;
        };
    };
};
