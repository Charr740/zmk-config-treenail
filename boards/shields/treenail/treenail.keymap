#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_1 {
            bindings = <
&kp ESC    &kp Q     &kp W     &kp E   &kp R      &kp T   &kp Y      &kp U      &kp I      &kp O     &kp P     &kp BSPC
&kp TAB    &kp A     &kp S     &kp D   &kp F      &kp G   &kp H      &kp J      &kp K      &kp L     &kp SQT   &kp RET
&kp LSHFT  &kp Z     &kp X     &kp C   &kp V      &kp B   &kp N      &kp M      &kp COMMA  &kp DOT   &kp UP    &kp FSLH
&kp LCTRL  &kp LALT  &kp LGUI  &trans  &kp SPACE  &trans  &kp SPACE  &kp SPACE  &trans     &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
